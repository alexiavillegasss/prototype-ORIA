                },
                {
                    "field": "vulnerabilites.social.precarite",
                    "operator": "==",
                    "value": "averee"
                },
                {
                    "field": "vulnerabilites.social.isolement_relationnel",
                    "operator": "==",
                    "value": "critique"
                },
                {
                    "field": "vulnerabilites.sante.suivi_medical.continuité_soins",
                    "operator": "==",
                    "value": "rompue"
                },
                {
                    "field": "vulnerabilites.autonomie.autonomie_decisionnelle",
                    "operator": "==",
                    "value": "fortement_compromise"
                },
                {
                    "field": "vulnerabilites.autonomie.gestion_du_quotidien",
                    "operator": "==",
                    "value": "fortement_compromise"
                },
                {
                    "field": "usager.situation_actuelle.suspiion_malveillance",
                    "operator": "in",
                    "value": [
                        "violences psychologiques",
                        "violence physique",
                        "spoliation",
                        "maltraitance"
                    ]
                },
                {
                    "field": "usager.situation_actuelle.vulnerabilite",
                    "operator": "==",
                    "value": "oui"
                },
                {
                    "field": "usager.situation_actuelle.isolement",
                    "operator": "in",
                    "value": [
                        "isolement_social",
                        "isolement_famillial"
                    ]
                },
                {
                    "field": "usager.situation_actuelle.stabilite_apparente_situation",
                    "operator": "==",
                    "value": "instable"
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 95,
                "objectif_orientation": "maintien_a_domicile_renforce"
            }
        },
