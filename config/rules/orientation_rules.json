{
    "meta": {
        "id": "orientation_rules_v1",
        "version": "1.1.0",
        "description": "Règles d'orientation ORIA territoriales validées métier"
    },
    "global_rules": {
        "urgency_first": true,
        "allow_multiple_eligible_structures": true,
        "apply_priority_scoring": true
    },
    "eligibility_rules": [
        {
            "id": "eligibility_crt_01",
            "structure_type": "CRT",
            "label": "CRT - Centre de Ressources Territorial (Volet 2 - Accompagnement Renforcé)",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "complexite.niveau",
                    "operator": "==",
                    "value": "complexe"
                },
                {
                    "field": "evaluation.comid.epuisement_aidant",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "demande.motif_principal",
                    "operator": "contains_any",
                    "value": ["renforcement_domicile", "alternative_ehpad", "maintien_intensif", "maintien_a_domicile"]
                }
            ],
            "none_of": [
                {
                    "field": "demande.motif_principal",
                    "operator": "in",
                    "value": ["information_aides"]
                },
                {
                    "field": "usager.identite.age_estime",
                    "operator": "<=",
                    "value": 60
                },
                {
                    "field": "usager.situation_actuelle.GIR",
                    "operator": "not_in",
                    "value": [1, 2, 3, 4]
                }
            ],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 90,
                "objectif_orientation": "Maintien à domicile renforcé : Alternative à l'EHPAD pour les situations en perte d'autonomie importante ou complexité technique."
            }
        },
        {
            "id": "eligibility_cev_01",
            "structure_type": "CEV",
            "label": "CEV - Cellule Écoute et Vigilance (Urgence & Danger)",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "usager.situation_actuelle.suspicion_malveillance",
                    "operator": "in",
                    "value": [
                        "violences_psychologiques",
                        "violences_physiques",
                        "violences_sexuelles",
                        "negligence",
                        "spoliation_financiere",
                        "abus_de_confiance_ou_faiblesse",
                        "privation_de_droits",
                        "maltraitance_institutionnelle"
                    ]
                },
                {
                    "field": "vulnerabilites.habitat.securite_du_domicile",
                    "operator": "in",
                    "value": ["problematique", "critique", "danger_imminent"]
                }
            ],
            "none_of": [
                {
                    "comment": "Ces motifs purement administratifs ou d'accès aux soins ne peuvent pas coexister avec une situation de danger réel justifiant la CEV.",
                    "field": "demande.motif_principal",
                    "operator": "in",
                    "value": ["recherche_medecin", "acces_aux_soins", "information_aides"]
                }
            ],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 95,
                "objectif_orientation": "protection_et_mise_en_securite (Peut faire l'objet d'un signalement au pénal avec copie au Procureur de la République)"
            }
        },
        {
            "id": "eligibility_apa_service_01",
            "structure_type": "PSCG_SS_APA",
            "label": "PSCG SS APA - Pôle Social de Solidarité et de Gestion (APA)",
            "enabled": true,
            "all_of": [
                {
                    "field": "usager.situation_actuelle.APA",
                    "operator": "==",
                    "value": "oui"
                }
            ],
            "any_of": [],
            "none_of": [
                {
                    "field": "usager.identite.age_estime",
                    "operator": "<=",
                    "value": 60
                }
            ],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 100,
                "objectif_orientation": "Contacter votre référent APA au Conseil Départemental (PSCG SS APA) pour toute modification de plan d'aide ou besoin d'accompagnement social supplémentaire."
            }
        },
        {
            "id": "eligibility_clic_01",
            "structure_type": "CLIC",
            "label": "CLIC - Centre Local d'Information et de Coordination",
            "enabled": true,
            "all_of": [
                
            ],
            "any_of": [
                
                {
                    "field": "usager.situation_actuelle.PCH",
                    "operator": "==",
                    "value": "oui"
                },
                {
                    "field": "evaluation.comid.epuisement_aidant",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "demande.motif_principal",
                    "operator": "contains_any",
                    "value": ["maintien_a_domicile", "renforcement_domicile", "aide_a_domicile", "information_aides", "choix_prestataire", "portage_repas"]
                }
            ],
            "none_of": [
                {
                    "field": "demande.motif_principal",
                    "operator": "in",
                    "value": ["entree_en_etablissement", "ehpad", "recherche_medecin", "acces_aux_soins"]
                },
                {
                    "field": "usager.situation_actuelle.APA",
                    "operator": "==",
                    "value": "oui"
                },
                {
                    "field": "usager.identite.age_estime",
                    "operator": "<=",
                    "value": 60
                }
            ],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 80,
                "objectif_orientation": "Maintien à domicile : Information, évaluation, ouverture des droits (APA, CARSAT) et aide administrative (impôts, retraite). UNIQUEMENT si l'APA n'est pas déjà en place."
            }
        },
        {
            "id": "eligibility_uts_01",
            "structure_type": "UTS",
            "label": "UTS / ASPI - Unité Territoriale Sociale (Action Sociale Prévention Insertion)",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "evaluation.comid.precarite_financiere",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "vulnerabilites.social.precarite",
                    "operator": "in",
                    "value": ["possible", "probable", "averee"]
                },
                {
                    "field": "demande.motif_principal",
                    "operator": "contains_any",
                    "value": ["rsa", "violence_conjugale", "gestion_budget", "parentalite", "pas_premier_accueil", "logement"]
                },
                {
                    "field": "complexite.niveau",
                    "operator": "==",
                    "value": "complexe"
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 70,
                "objectif_orientation": "PAS (Premier Accueil Social) : Évaluation, ouverture de droits, aides financières ponctuelles. Accompagnement social (RSA, budget, logement, violences conjugales)."
            }
        },
        {
            "id": "eligibility_ccas_01",
            "structure_type": "CCAS",
            "label": "CCAS - Centre Communal d'Action Sociale",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "demande.motif_principal",
                    "operator": "contains_any",
                    "value": ["information", "information_locale", "aide_financiere", "rsa", "aide_alimentaire", "secours_urgence", "factures", "aide_administrative", "foyer_logement", "residence_autonomie"]
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "moyenne",
                "base_priority_score": 60,
                "objectif_orientation": "Information et premier accueil social : Se renseigner sur les aides légales (RSA), les secours d'urgence (alimentaire, factures) et les logements seniors de la commune."
            }
        },
        {
            "id": "eligibility_dac_01",
            "structure_type": "DAC",
            "label": "DAC - Dispositif d'Appui à la Coordination (Dernier Recours)",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "complexite.niveau",
                    "operator": "==",
                    "value": "complexe"
                },
                {
                    "field": "demande.motif_principal",
                    "operator": "contains_any",
                    "value": ["refus_de_soins", "refus_aide_domicile", "coordination_complexe", "rupture_de_parcours", "conflit_professionnel"]
                },
                {
                    "field": "vulnerabilites.social.isolement_relationnel",
                    "operator": "==",
                    "value": "critique"
                },
                {
                    "field": "vulnerabilites.sante.hospitalisation.statut",
                    "operator": "in",
                    "value": ["recente", "en_cours"]
                },
                {
                    "field": "vulnerabilites.social.risque_epuisement_entourage",
                    "operator": "in",
                    "value": ["probable", "eleve"]
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 80,
                "objectif_orientation": "Coordination de haut niveau : Évaluation multidimensionnelle et déblocage de situations complexes (sanitaire, social, médico-social). Plan Personnalisé de Coordination."
            }
        },
        {
            "id": "eligibility_dac_02",
            "structure_type": "DAC",
            "label": "DAC - Dépendance lourde sans aidant de proximité",
            "enabled": true,
            "all_of": [
                {
                    "field": "usager.situation_actuelle.GIR",
                    "operator": "in",
                    "value": [1, 2, 3]
                },
                {
                    "field": "usager.cadre_de_vie.aidant_regulier",
                    "operator": "==",
                    "value": "non"
                }
            ],
            "any_of": [],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 85,
                "objectif_orientation": "Situation de forte perte d'autonomie (GIR 1-3) sans aidant de proximité identifié. Risque majeur de rupture de maintien à domicile."
            }
        },
        {
            "id": "eligibility_dac_03",
            "structure_type": "DAC",
            "label": "DAC - Échec ou saturation des aides professionnelles",
            "enabled": true,
            "all_of": [
                {
                    "field": "vulnerabilites.sante.professionnels_domicile",
                    "operator": "==",
                    "value": "oui"
                },
                {
                    "field": "complexite.niveau",
                    "operator": "==",
                    "value": "complexe"
                }
            ],
            "any_of": [],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 85,
                "objectif_orientation": "Professionnels (SAAD, IDEL) déjà présents au domicile mais en situation de saturation ou d'échec face à une complexité systémique."
            }
        },
        {
            "id": "eligibility_dac_04",
            "structure_type": "DAC",
            "label": "DAC - Situation de complexité multidimensionnelle (Sanitaire, Social, Médico-social)",
            "enabled": true,
            "all_of": [
                {
                    "field": "complexite.score_total",
                    "operator": ">=",
                    "value": 4
                }
            ],
            "any_of": [
                {
                    "field": "evaluation.comid.psychiatrie",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "evaluation.comid.addiction",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "evaluation.comid.troubles_cognitifs",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "evaluation.comid.epuisement_aidant",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "evaluation.comid.logement_inadapte",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "evaluation.comid.opposition_soins",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "evaluation.comid.precarite_financiere",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "evaluation.comid.isolement_social",
                    "operator": "==",
                    "value": true
                },
                {
                    "field": "complexite.niveau",
                    "operator": "==",
                    "value": "complexe"
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 92,
                "objectif_orientation": "Situation de forte complexité multidimensionnelle (sanitaire, social et médico-social) : Évaluation globale et coordination intensive par le DAC pour débloquer le parcours de vie à domicile."
            }
        },
        {
            "id": "eligibility_dac_05",
            "structure_type": "DAC",
            "label": "DAC - Refus de soins ou d'aide (Priorité Absolue)",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "demande.motif_principal",
                    "operator": "in",
                    "value": ["refus_de_soins", "refus_aide_domicile"]
                },
                {
                    "field": "evaluation.comid.opposition_soins",
                    "operator": "==",
                    "value": true
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 102,
                "objectif_orientation": "Priorité Absolue - Crise par refus ou opposition de soins/aides : Rupture critique de parcours nécessitant l'intervention immédiate du DAC pour évaluer et débloquer la situation."
            }
        },
        {
            "id": "eligibility_dac_06",
            "structure_type": "DAC",
            "label": "DAC - Suspicion de Diogène ou incurie",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "usager.cadre_de_vie.etat_logement",
                    "operator": "in",
                    "value": ["diogene", "incurie"]
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 92,
                "objectif_orientation": "Insalubrité ou négligence critique à domicile : Suspicion ou syndrome de Diogène/incurie avéré nécessitant une coordination multidimensionnelle renforcée par le DAC."
            }
        },
        {
            "id": "eligibility_cpts_01",
            "structure_type": "CPTS",
            "label": "CPTS - Communauté Professionnelle Territoriale de Santé",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "vulnerabilites.sante.suivi_medical.medecin_traitant",
                    "operator": "in",
                    "value": ["absent", "non_identifie_avec_certitude"]
                },
                {
                    "field": "demande.motif_principal",
                    "operator": "contains_any",
                    "value": ["recherche_medecin", "acces_aux_soins", "misas", "renoncement_aux_soins", "demenagement", "retraite_medecin"]
                }
            ],
            "none_of": [
                {
                    "field": "usager.identite.age_estime",
                    "operator": "<=",
                    "value": 60
                }
            ],
            "result": {
                "eligible": true,
                "base_pertinence": "moyenne",
                "base_priority_score": 65,
                "objectif_orientation": "Accès aux soins : Recherche de médecin traitant (justifiée par retraite/déménagement) et dispositif MISAS pour éviter le renoncement aux soins."
            }
        },
        {
            "id": "eligibility_hopital_01",
            "structure_type": "SERVICE_SOCIAL_HOPITAL",
            "label": "Service Social de l'Hôpital (Transition Sociale Urgente)",
            "enabled": true,
            "all_of": [
                {
                    "field": "demande.motif_principal",
                    "operator": "in",
                    "value": ["sortie_hospitalisation", "maintien_a_domicile", "aide_alimentaire", "secours_urgence", "information_aides", "refus_aide_domicile", "refus_de_soins"]
                },
                {
                    "field": "vulnerabilites.sante.hospitalisation.statut",
                    "operator": "in",
                    "value": ["en_cours", "recente"]
                }
            ],
            "any_of": [],
            "none_of": [
                {
                    "comment": "Recherche de médecin = problème d'accès aux soins (CPTS), pas une transition hospitalière sociale.",
                    "field": "demande.motif_principal",
                    "operator": "in",
                    "value": ["recherche_medecin", "acces_aux_soins"]
                }
            ],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 98,
                "objectif_orientation": "Accompagnement social hospitalier d'urgence : Organisation de la sortie complexe et gestion des problématiques sociales (perte de papiers, isolement, logement, aides) en lien direct avec le service social de l'établissement."
            }
        },
        {
            "id": "eligibility_hopital_02",
            "structure_type": "SERVICE_SOCIAL_HOPITAL",
            "label": "Service Social de l'Hôpital (Standard)",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "vulnerabilites.sante.hospitalisation.statut",
                    "operator": "in",
                    "value": ["en_cours", "recente"]
                }
            ],
            "none_of": [
                {
                    "comment": "Recherche de médecin = problème d'accès aux soins (CPTS), pas un accompagnement hospitalier.",
                    "field": "demande.motif_principal",
                    "operator": "in",
                    "value": ["recherche_medecin", "acces_aux_soins"]
                }
            ],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 95,
                "objectif_orientation": "Accompagnement social en milieu hospitalier : Organisation de la sortie, aide aux démarches et lien avec les services extérieurs."
            }
        }
    ]
}