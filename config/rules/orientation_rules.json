{
  "meta": {
    "id": "orientation_rules_hybrid_v1",
    "version": "2.0.0",
    "description": "Règles d'orientation ORIA Hybrides : Garde-fous et Pondération clinique"
  },
  "guardrails": [
    {
      "id": "guardrail_police",
      "structure_type": "POLICE",
      "action": "force",
      "priority": 110,
      "objective": "Intervention immédiate des forces de l'ordre en cas d'agression physique active et en cours ou danger vital imminent.",
      "conditions": [
        {"field": "adresseur.degre_urgence_percu", "operator": "==", "value": "critique"},
        {"field": "demande.motif_principal", "operator": "==", "value": "secours_urgence"}
      ]
    },
    {
      "id": "guardrail_cev_physique",
      "structure_type": "CEV",
      "action": "force",
      "priority": 107,
      "objective": "Mise en sécurité immédiate et protection d'urgence des majeurs vulnérables en situation de violence physique active ou menacée.",
      "conditions": [
        {"field": "usager.situation_actuelle.suspicion_malveillance", "operator": "==", "value": "violences_physiques"}
      ]
    },
    {
      "id": "guardrail_hospit_en_cours",
      "structure_type": "SERVICE_SOCIAL_HOPITAL",
      "action": "force",
      "priority": 95,
      "objective": "Accompagnement social en milieu hospitalier : Organisation de la sortie et lien direct avec le service social de l'établissement.",
      "conditions": [
        {"field": "vulnerabilites.sante.hospitalisation.statut", "operator": "==", "value": "en_cours"}
      ]
    },
    {
      "id": "exclude_clic_under_60",
      "structure_type": "CLIC",
      "action": "exclude",
      "conditions": [
        {"field": "usager.identite.age_estime", "operator": "<=", "value": 60},
        {"field": "usager.situation_actuelle.PCH", "operator": "!=", "value": "oui"}
      ]
    },
    {
      "id": "exclude_crt_under_60",
      "structure_type": "CRT",
      "action": "exclude",
      "conditions": [
        {"field": "usager.identite.age_estime", "operator": "<=", "value": 60}
      ]
    },
    {
      "id": "exclude_apa_under_60",
      "structure_type": "PSCG_SS_APA",
      "action": "exclude",
      "conditions": [
        {"field": "usager.identite.age_estime", "operator": "<=", "value": 60}
      ]
    },
    {
      "id": "exclude_compagnons_complex",
      "structure_type": "COMPAGNONS_BATISSEURS",
      "action": "exclude",
      "conditions": [
        {"field": "complexite.niveau", "operator": "==", "value": "complexe"}
      ]
    },
    {
      "id": "exclude_compagnons_precarity_financial",
      "structure_type": "COMPAGNONS_BATISSEURS",
      "action": "exclude",
      "conditions": [
        {"field": "evaluation.comid.precarite_financiere", "operator": "==", "value": true}
      ]
    },
    {
      "id": "exclude_compagnons_precarity_social",
      "structure_type": "COMPAGNONS_BATISSEURS",
      "action": "exclude",
      "conditions": [
        {"field": "vulnerabilites.social.precarite", "operator": "in", "value": ["possible", "probable", "averee"]}
      ]
    },
    {
      "id": "exclude_compagnons_apa",
      "structure_type": "COMPAGNONS_BATISSEURS",
      "action": "exclude",
      "conditions": [
        {"field": "usager.situation_actuelle.APA", "operator": "==", "value": "oui"}
      ]
    },
    {
      "id": "exclude_compagnons_autonomy",
      "structure_type": "COMPAGNONS_BATISSEURS",
      "action": "exclude",
      "conditions": [
        {"field": "evaluation.comid.perte_autonomie_recente", "operator": "==", "value": true}
      ]
    },
    {
      "id": "exclude_compagnons_addiction",
      "structure_type": "COMPAGNONS_BATISSEURS",
      "action": "exclude",
      "conditions": [
        {"field": "evaluation.comid.addiction", "operator": "==", "value": true}
      ]
    },
    {
      "id": "exclude_compagnons_psychiatrie",
      "structure_type": "COMPAGNONS_BATISSEURS",
      "action": "exclude",
      "conditions": [
        {"field": "evaluation.comid.psychiatrie", "operator": "==", "value": true}
      ]
    }
  ],
  "scoring_rules": [
    {
      "id": "score_malveillance_social",
      "conditions": [
        {"field": "usager.situation_actuelle.suspicion_malveillance", "operator": "in", "value": ["violences_psychologiques", "spoliation_financiere", "negligence", "abus_de_confiance_ou_faiblesse", "privation_de_droits", "maltraitance_institutionnelle"]}
      ],
      "points": {
        "CEV": 85
      }
    },
    {
      "id": "score_recherche_medecin",
      "conditions": [
        {"field": "demande.motif_principal", "operator": "==", "value": "recherche_medecin"}
      ],
      "points": {
        "CPTS": 80
      }
    },
    {
      "id": "score_medecin_absent",
      "conditions": [
        {"field": "vulnerabilites.sante.suivi_medical.medecin_traitant", "operator": "==", "value": "absent"}
      ],
      "points": {
        "CPTS": 50
      }
    },
    {
      "id": "score_maintien_a_domicile",
      "conditions": [
        {"field": "demande.motif_principal", "operator": "in", "value": ["maintien_a_domicile", "aide_a_domicile", "information_aides", "choix_prestataire", "portage_repas", "evaluation_globale"]}
      ],
      "points": {
        "CLIC": 35,
        "CRT": 15
      }
    },
    {
      "id": "score_gir_1_4",
      "conditions": [
        {"field": "usager.situation_actuelle.GIR", "operator": "in", "value": [1, 2, 3, 4]}
      ],
      "points": {
        "CRT": 50,
        "CLIC": 20
      }
    },
    {
      "id": "score_epuisement_aidant",
      "conditions": [
        {"field": "evaluation.comid.epuisement_aidant", "operator": "==", "value": true}
      ],
      "points": {
        "CRT": 40,
        "CLIC": 25,
        "DAC": 15
      }
    },
    {
      "id": "score_troubles_cognitifs",
      "conditions": [
        {"field": "evaluation.comid.troubles_cognitifs", "operator": "==", "value": true}
      ],
      "points": {
        "CLIC": 20,
        "CRT": 20,
        "DAC": 10
      }
    },
    {
      "id": "score_perte_autonomie",
      "conditions": [
        {"field": "evaluation.comid.perte_autonomie_recente", "operator": "==", "value": true}
      ],
      "points": {
        "CLIC": 20,
        "CRT": 25,
        "DAC": 10
      }
    },
    {
      "id": "score_hospit_recente",
      "conditions": [
        {"field": "vulnerabilites.sante.hospitalisation.statut", "operator": "==", "value": "recente"}
      ],
      "points": {
        "SERVICE_SOCIAL_HOPITAL": 45,
        "CLIC": 15,
        "CRT": 15,
        "DAC": 15
      }
    },
    {
      "id": "score_precarite_sociale_financiere",
      "conditions": [
        {"field": "vulnerabilites.social.precarite", "operator": "in", "value": ["possible", "probable", "averee"]}
      ],
      "points": {
        "UTS": 60,
        "CCAS": 25
      }
    },
    {
      "id": "score_precarite_comid",
      "conditions": [
        {"field": "evaluation.comid.precarite_financiere", "operator": "==", "value": true}
      ],
      "points": {
        "UTS": 55,
        "CCAS": 35
      }
    },
    {
      "id": "score_motifs_sociaux",
      "conditions": [
        {"field": "demande.motif_principal", "operator": "in", "value": ["logement", "rsa", "gestion_budget", "aide_administrative"]}
      ],
      "points": {
        "UTS": 50,
        "CCAS": 30
      }
    },
    {
      "id": "score_diogene_incurie",
      "conditions": [
        {"field": "usager.cadre_de_vie.etat_logement", "operator": "in", "value": ["diogene", "incurie"]}
      ],
      "points": {
        "COMPAGNONS_BATISSEURS": 75,
        "UTS": 30,
        "DAC": 15
      }
    },
    {
      "id": "score_apa_actif",
      "conditions": [
        {"field": "usager.situation_actuelle.APA", "operator": "==", "value": "oui"}
      ],
      "points": {
        "PSCG_SS_APA": 80,
        "DAC": 10
      }
    },
    {
      "id": "score_refus_de_soins",
      "conditions": [
        {"field": "demande.motif_principal", "operator": "in", "value": ["refus_de_soins", "refus_aide_domicile"]}
      ],
      "points": {
        "CLIC": 30,
        "CRT": 30,
        "DAC": 10
      }
    },
    {
      "id": "score_opposition_soins_comid",
      "conditions": [
        {"field": "evaluation.comid.opposition_soins", "operator": "==", "value": true}
      ],
      "points": {
        "CLIC": 25,
        "CRT": 25,
        "DAC": 10
      }
    },
    {
      "id": "score_access_aux_soins",
      "conditions": [
        {"field": "demande.motif_principal", "operator": "in", "value": ["acces_aux_soins", "misas", "renoncement_aux_soins"]}
      ],
      "points": {
        "CPTS": 50,
        "CLIC": 10
      }
    },
    {
      "id": "score_age_senior",
      "conditions": [
        {"field": "usager.identite.age_estime", "operator": ">=", "value": 75}
      ],
      "points": {
        "CLIC": 25,
        "CRT": 25,
        "DAC": 10
      }
    },
    {
      "id": "score_ehpad_ash_ccas_clic",
      "conditions": [
        {"field": "evaluation.comid.precarite_financiere", "operator": "==", "value": true},
        {"field": "evaluation.comid.isolement_social", "operator": "==", "value": true},
        {"field": "evaluation.comid.perte_autonomie_recente", "operator": "==", "value": true}
      ],
      "points": {
        "CCAS": 55,
        "CLIC": 30
      }
    },
    {
      "id": "score_psychiatrie_complexite",
      "conditions": [
        {"field": "evaluation.comid.psychiatrie", "operator": "==", "value": true}
      ],
      "points": {
        "DAC": 35,
        "UTS": 20
      }
    }
  ]
}