{
    "meta": {
        "id": "orientation_rules_v1",
        "version": "1.0.1",
        "description": "Règle d'orientation ORIA par structure, priorisation et fallback parcours PA maintient à domicile"
    },
    "global_rules": {
        "urgency_first": true,
        "allow_multiple_eligible_structures": true,
        "apply_priority_scoring": true
    },
    "eligibility_rules": [
        {
            "id": "eligibility_crt_01",
            "structure_type": "CRT",
            "label": "CRT - personne agé avec besoin de maintien a domicile renforce",
            "enabled": true,
            "all_of": [
                {
                    "field": "usager.identite.age_estime",
                    "operator": ">=",
                    "value": 60
                },
                {
                    "field": "demande.motif_principal",
                    "operator": "contains_any",
                    "value": [
                        "maintien_a_domicile",
                        "renforcement_domicile"
                    ]
                }
            ],
            "any_of": [
                {
                    "field": "usager.situation_actuelle.GIR",
                    "operator": "in",
                    "value": [
                        1,
                        2,
                        3,
                        4
                    ]
                },
                {
                    "field": "complexite.niveau",
                    "operator": "==",
                    "value": "complexe"
                }
            ],
            "none_of": [],
            "result": {
                "eligible": true,
                "base_pertinence": "eleve",
                "base_priority_score": 90,
                "objectif_orientation": "maintien_a_domicile_renforce"
            }
        },
        {
            "id": "eligibility_cev_01",
            "structure_type": "CEV",
            "label": "CEV - Célule écoute et vigilance signalement pour adulte vulnérable, danger, etc ...",
            "enabled": true,
            "all_of": [],
            "any_of": [
                {
                    "field": "vulnerabilites.social.soutien_familial",
                    "operator": "==",
                    "value": "absent"
